<script>
(() => {
  const hero=document.querySelector('#blueman-exact-hero');
  const art=hero?.querySelector('.be-art');
  if(!art) return;
  const cards=[...art.querySelectorAll('.be-card')];
  const alternatives=[...document.querySelectorAll('.nft-card img')];
  const backIndexes=[0,3,4];
  cards.forEach((card,index)=>{
    const image=card.querySelector('img');
    const label=card.querySelector('em');
    const alternate=alternatives[backIndexes[index]];
    if(!image || !label || !alternate) return;
    if(index===0){
      image.src='data:image/png;base64,';
      image.alt='Original BlueMan NFT number 4';
    }
    card.tabIndex=0;
    card.setAttribute('role','button');
    card.setAttribute('aria-label',`${image.alt}. Reveal another original BlueMan NFT.`);
    const inner=document.createElement('div');
    inner.className='be-card-inner';
    const front=document.createElement('div');
    front.className='be-card-face front';
    front.append(label,image);
    const back=document.createElement('div');
    back.className='be-card-face back';
    const backLabel=document.createElement('em');
    backLabel.textContent='ORIGINAL BLUEMAN';
    const backImage=alternate.cloneNode(true);
    if(index===0){
      backImage.src='data:image/png;base64,';
      backImage.alt='Original BlueMan NFT artwork with headphones';
    }
    if(index===2){
      backImage.src='data:image/png;base64,';
      backImage.alt='Original green crown BlueMan NFT artwork';
    }
    back.append(backLabel,backImage);
    inner.append(front,back);
    card.append(inner);

    card.addEventListener('pointermove',event=>{
      if(event.pointerType==='touch') return;
      const rect=card.getBoundingClientRect();
      const x=(event.clientX-rect.left)/rect.width-.5;
      const y=(event.clientY-rect.top)/rect.height-.5;
      card.style.setProperty('--tilt-x',`${-y*5}deg`);
      card.style.setProperty('--tilt-y',`${x*6}deg`);
    },{passive:true});
    card.addEventListener('pointerenter',event=>{
      if(event.pointerType==='touch') return;
      cards.forEach(other=>{if(other!==card) other.classList.remove('is-active')});
      card.classList.add('is-active');
    });
    card.addEventListener('pointerleave',()=>{
      card.classList.remove('is-active');
      card.style.setProperty('--tilt-x','0deg');
      card.style.setProperty('--tilt-y','0deg');
    });
    const toggle=()=>{
      const willOpen=!card.classList.contains('is-flipped');
      cards.forEach(other=>other.classList.remove('is-flipped'));
      card.classList.toggle('is-flipped',willOpen);
    };
    card.addEventListener('click',event=>{
      toggle();
    });
    card.addEventListener('keydown',event=>{
      if(event.key==='Enter'||event.key===' '){event.preventDefault();toggle()}
    });
  });
})();
</script>
