<script>
(()=>{
  const storyArt=document.querySelector('#blueman-complete-page .thanks .visual');
  if(!storyArt||window.matchMedia('(prefers-reduced-motion: reduce)').matches)return;
  storyArt.addEventListener('pointermove',(event)=>{
    if(event.pointerType==='touch')return;
    const rect=storyArt.getBoundingClientRect();
    const px=(event.clientX-rect.left)/rect.width-.5;
    const py=(event.clientY-rect.top)/rect.height-.5;
    storyArt.style.setProperty('--story-tilt-x',`${(-py*2.2).toFixed(2)}deg`);
    storyArt.style.setProperty('--story-tilt-y',`${(px*2.2).toFixed(2)}deg`);
  });
  storyArt.addEventListener('pointerleave',()=>{
    storyArt.style.setProperty('--story-tilt-x','0deg');
    storyArt.style.setProperty('--story-tilt-y','0deg');
  });
})();
</script>
